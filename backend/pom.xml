            <scope>runtime</scope>
        </dependency> -->

        <!-- Spring Data JPA (already present) 
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency> -->
    </dependencies>

    <build>

